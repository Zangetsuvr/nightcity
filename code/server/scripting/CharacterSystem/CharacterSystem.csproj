<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberpunkSdk\CyberpunkSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite: the database is one file on the server, no separate program needed.
         The native SQLite library lands in runtimes/<platform>/native (see NativeSqlite.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<OutputPath>..\..\..\..\build\windows\x64\debug\plugins\CharacterSystem</OutputPath>
		<PackageOutputPath>..\..\..\..\build\windows\x64\debug\plugins\CharacterSystem</PackageOutputPath>
		<NoWarn>1701;1702;3270</NoWarn>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

</Project>
